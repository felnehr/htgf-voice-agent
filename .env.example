# Demo
DEMO_PIN=htgf

# Required for live voice
DEEPGRAM_API_KEY=

# Required for ElevenLabs TTS via Deepgram. Emma is skipped; a free premade voice is used.
ELEVENLABS_API_KEY=
# Optional. Defaults to a free premade voice (Bella, Sarah, …).
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=

# Optional. Without it, the pre-call company lookup and search_web stay empty.
TAVILY_API_KEY=

# Optional hosted SQLite. Locally the app uses ./data/app.db.
# On Vercel without Turso, history lives in /tmp and is ephemeral.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
